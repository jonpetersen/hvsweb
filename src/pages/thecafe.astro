---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { getGalleryItems } from '../lib/galleries.ts';
import { HOURS } from '../consts.ts';

const items = await getGalleryItems('thecafe');
---

<BaseLayout title="The Café/Deli">
  <section id="cafe" class="hero-section center-content">
    <h2 class="red-text">The Café/Deli</h2>

    <div class="info-card">
      <section class="center-section left-aligned-text" aria-label="About the café and deli">
        <p>
          <strong
            >The Café/Deli is open {HOURS.shop.days} {HOURS.shop.range}, with
            last orders for the café at {HOURS.shop.lastOrdersTime}.</strong
          >
        </p>
        <p>
          The deli-café menu is published on a blackboard outside the shop
          and includes hot pies and sausage rolls; sandwiches, wraps, baps
          and toasties; hot drinks, milkshakes, chilled soft drinks, iced
          coffee; cakes and tray bakes and more.
        </p>
        <p>
          Food and drinks purchased from the deli can be taken away or
          enjoyed inside the shop and at our outdoor picnic tables.
        </p>
      </section>
    </div>
  </section>

  <section id="deli-gallery" class="gallery-section hero-section">
    <GalleryGrid items={items} />
  </section>
</BaseLayout>
